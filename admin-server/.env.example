# 관리 서버 자체 포트
PORT=4000

# MySQL (C# GameServer와 동일한 DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=game_server_cs

# Redis (C# GameServer와 동일한 인스턴스)
REDIS_URL=redis://127.0.0.1:6379

# 로컬 LLM (LM Studio, OpenAI 호환 API)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions

# Discord Webhook (비워두면 알림 전송 생략)
DISCORD_WEBHOOK_URL=
